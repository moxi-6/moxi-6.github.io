<!doctype html>
<html lang="{{ language }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="记录一生一芯学习、开发实践、工具获取与随笔。">
  <meta name="theme-color" content="#3f51b5">
  <title>{{ title }}</title>
  <link rel="icon" href="{{ resource "favicon.svg" }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ resource "css/general.css" }}">
  <script>
    (function () {
      var saved = localStorage.getItem('moxi-theme');
      var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
    })();
  </script>
</head>
<body data-source-path="{{ path }}" data-root="{{ path_to_root }}" data-chapter-title="{{ chapter_title }}">
  <a class="skip-link" href="#main-content">跳到正文</a>

  <header class="site-header">
    <div class="header-main">
      <div class="header-inner">
        <button class="mobile-menu-button" type="button" aria-label="打开文章目录" aria-controls="site-sidebar" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"/></svg>
        </button>

        <a class="brand" href="{{ path_to_root }}index.html" aria-label="返回首页">
          <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H11v16H5.5A2.5 2.5 0 0 0 3 21.5v-16Zm18 0A2.5 2.5 0 0 0 18.5 3H13v16h5.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"/></svg>
          <span>Moxi 的个人网站</span>
        </a>

        <button class="header-search search-open" type="button" aria-label="搜索网站" title="搜索">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 20-5.2-5.2a7.5 7.5 0 1 0-1 1L20 21l1-1ZM5.5 10a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Z"/></svg>
          <span>搜索文章标题</span>
          <kbd>Ctrl K</kbd>
        </button>

        <div class="header-tools">
          <button class="header-icon theme-toggle" type="button" aria-label="切换明暗主题" title="切换主题">
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.2 2.2A10 10 0 1 0 21.8 14 8 8 0 0 1 12.2 2.2Zm-.1 2.2a10.1 10.1 0 0 0 7.5 11.4 8 8 0 1 1-7.5-11.4Z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5h1v3h-2V2h1Zm0 17h1v3h-2v-3h1ZM2 11h3v2H2v-2Zm17 0h3v2h-3v-2ZM4.2 5.6l1.4-1.4 2.1 2.1-1.4 1.4-2.1-2.1Zm12.1 12.1 1.4-1.4 2.1 2.1-1.4 1.4-2.1-2.1Zm2.1-13.5 1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1ZM6.3 16.3l1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1Z"/></svg>
          </button>
          <a class="header-icon" href="https://github.com/moxi-6/moxi-6.github.io" target="_blank" rel="noreferrer" aria-label="打开 GitHub 仓库" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.5-4.1-1.5-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C16.6 4.3 17.6 4.6 17.6 4.6c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.5-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.4c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <nav class="top-tabs" aria-label="主导航">
      <div class="tabs-inner">
        <a class="tab-link" data-section="home" href="{{ path_to_root }}index.html">首页</a>
        <a class="tab-link" data-section="about" href="{{ path_to_root }}about/index.html">我</a>
        <a class="tab-link" data-section="ysyx" href="{{ path_to_root }}ysyx/index.html">一生一芯</a>
        <a class="tab-link" data-section="development" href="{{ path_to_root }}development/index.html">开发</a>
        <a class="tab-link" data-section="tools" href="{{ path_to_root }}tools/index.html">工具</a>
        <a class="tab-link" data-section="essays" href="{{ path_to_root }}essays/index.html">随笔</a>
      </div>
    </nav>
  </header>

  <div class="sidebar-backdrop" hidden></div>

  <div class="docs-shell">
    <aside id="site-sidebar" class="site-sidebar" aria-label="文章目录">
      <div class="sidebar-sticky">
        <div class="sidebar-heading" id="sidebar-heading">目录</div>
        <nav class="sidebar-nav" id="sidebar-nav"></nav>
      </div>
    </aside>

    <main id="main-content" class="article">
      <div class="article-heading">
        <a class="edit-link" href="https://github.com/moxi-6/moxi-6.github.io/edit/main/src/{{ path }}" target="_blank" rel="noreferrer" title="在 GitHub 编辑此页" aria-label="在 GitHub 编辑此页">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 17.3-.7 4.4 4.4-.7L18.4 9.3l-3.7-3.7L3 17.3Zm17.7-11.7a1 1 0 0 0 0-1.4L19.8 3a1 1 0 0 0-1.4 0l-2.2 2.2 3.7 3.7 2.2-2.2Z"/></svg>
        </a>
      </div>
      <article class="article-body">
        {{{ content }}}
      </article>

      <nav class="page-navigation" id="page-navigation" aria-label="上一篇与下一篇"></nav>

      <div class="page-end"><a href="#main-content">回到页面顶部</a></div>
    </main>

    <aside class="toc-panel" aria-label="本页目录">
      <div class="toc-sticky">
        <div class="toc-title">目录</div>
        <nav class="toc-list" id="page-toc"></nav>
      </div>
    </aside>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>Moxi · 内容持续更新</span>
      <span>由 Markdown 与 mdBook 驱动</span>
    </div>
  </footer>

  <div class="search-dialog" hidden>
    <div class="search-backdrop"></div>
    <section class="search-panel" role="dialog" aria-modal="true" aria-label="搜索网站">
      <div class="search-box">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 20-5.2-5.2a7.5 7.5 0 1 0-1 1L20 21l1-1ZM5.5 10a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Z"/></svg>
        <input class="search-input" type="search" placeholder="搜索文章标题" autocomplete="off">
        <button class="search-close" type="button" aria-label="关闭搜索">ESC</button>
      </div>
      <div class="search-results"><p class="search-hint">输入关键词开始搜索。</p></div>
    </section>
  </div>

  <script>
    window.MOXI_ROOT = "{{ path_to_root }}";
    window.MOXI_CURRENT_PATH = "{{ path }}";
    window.MOXI_CHAPTERS = {{chapters}};
  </script>
  <script src="{{ resource "book.js" }}"></script>
</body>
</html>
